# Supabase Configuration
# Get these values from your Supabase project dashboard
# Go to: https://supabase.com/dashboard -> Your Project -> Settings -> API

REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-public-key-here

# Note: The anon key should be very long (150+ characters) and start with "eyJ"
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6...